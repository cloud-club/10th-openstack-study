        <mxCell id="c25" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Pretendard;fontSize=13;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6B7A;" value="&lt;b&gt;provider_network&lt;/b&gt; 192.168.200.0/24 — br-ex 쪽, 라우터 외부 IP .2 고정, FIP 풀 .101~.150&lt;br&gt;&lt;b&gt;tenant_network&lt;/b&gt; 10.10.10.0/24 — br-int 쪽, 인스턴스 사설망&lt;br&gt;&lt;code&gt;sudo ip netns&lt;/code&gt; 로 qrouter · qdhcp 가 보임 → 6·7회차 실습 (ML2/OVS를 고른 이유)" vertex="1">
          <mxGeometry height="110" width="680" x="340" y="550" as="geometry" />
        </mxCell>
        <mxCell id="c26" parent="1" style="text;html=1;whiteSpace=wrap;fontFamily=Pretendard;fontSize=13;align=left;verticalAlign=middle;fontSize=12;fontColor=#5B6B7A;" value="패킷 경로 (인스턴스 → 인터넷)&lt;br&gt;인스턴스 → br-int → qrouter(SNAT) → br-ex → MASQUERADE → eth0 → 가비아 NAT" vertex="1">
          <mxGeometry height="110" width="230" x="80" y="550" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
