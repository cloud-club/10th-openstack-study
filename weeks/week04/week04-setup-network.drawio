        <mxCell id="c9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Pretendard;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F6F8FA;strokeColor=#C9D3DC;" value="&lt;b&gt;network_interface&lt;/b&gt; = eth0&lt;br&gt;&lt;b&gt;kolla_internal_vip_address&lt;/b&gt; = 사설 IP&lt;br&gt;haproxy·keepalived 끔 → VIP = 호스트 IP" vertex="1">
