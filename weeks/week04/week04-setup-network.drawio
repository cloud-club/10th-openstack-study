        <mxCell id="c10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Pretendard;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F6F8FA;strokeColor=#C9D3DC;" value="&lt;b&gt;/etc/hosts&lt;/b&gt;&lt;br&gt;&lt;s&gt;127.0.1.1 호스트명&lt;/s&gt; → &lt;b&gt;사설IP 호스트명&lt;/b&gt; 으로 치환&lt;br&gt;호스트명이 eth0 IP로 풀려야 RabbitMQ가 루프백에 안 붙음" vertex="1">
          <mxGeometry height="90" width="390" x="630" y="190" as="geometry" />
        </mxCell>
        <mxCell id="c11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Pretendard;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#F6F8FA;strokeColor=#C9D3DC;" value="&lt;b&gt;커널 파라미터&lt;/b&gt;  (/etc/sysctl.d/99-kolla.conf)&lt;br&gt;&lt;b&gt;ip_forward = 1&lt;/b&gt;  호스트가 패킷을 넘겨줌 (라우터 역할)&lt;br&gt;   Kolla가 도커의 ip_forward 관리를 꺼서 직접 켬&lt;br&gt;&lt;b&gt;rp_filter = 2&lt;/b&gt;  들어온 길 ≠ 나갈 길이어도 버리지 않음" vertex="1">
          <mxGeometry height="110" width="440" x="80" y="310" as="geometry" />
        </mxCell>
        <mxCell id="c12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Pretendard;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#1E2A36;strokeColor=#1E2A36;fontColor=#D6E4F0;" value="&lt;b&gt;Docker 엔진&lt;/b&gt;  (bootstrap-servers가 설치)&lt;br&gt;지금은 컨테이너 0개 → 5회차 deploy에서 수십 개 생성&lt;br&gt;Kolla 컨테이너는 &lt;b&gt;host 네트워크&lt;/b&gt;를 그대로 씀&lt;br&gt;→ 위의 eth0 · /etc/hosts · 커널 설정이 곧 서비스의 네트워크" vertex="1">
