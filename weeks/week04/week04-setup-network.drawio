        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontFamily=Pretendard;fontSize=13;align=left;spacingLeft=10;spacingRight=8;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8A99A8;dashed=1;" value="&lt;b&gt;veth0&lt;/b&gt;&lt;br&gt;UP만 · 어디에도 미부착&lt;br&gt;(브리지에 물리면 플러딩 유출)" vertex="1">
